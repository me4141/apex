# J.A.R.V.I.S. - offline / self-hosted configuration (fork of vierisid/jarvis).
# Copy to `.env`. Bun loads `.env` automatically when run from the repo root
# (`bun run start`); docker-compose.offline.yml passes it via env_file.

# ── Isolation ────────────────────────────────────────────────────────────────
# Master switch. Refuses every non-local LLM / STT / TTS / realtime endpoint,
# ignores hosted usejarvis blocks, forces telemetry off and wake-word detection
# to the in-browser openwakeword engine. See docs/OFFLINE.md.
JARVIS_OFFLINE=1
# Extra hosts to treat as local (exact match, comma separated), e.g. a GPU box
# with a public DNS name on your LAN. Loopback, RFC1918, *.local, *.lan and
# single-label (docker service) names are already local.
# JARVIS_OFFLINE_ALLOW_HOSTS=gpu.mylab.example

# Belt-and-braces for tools that honor the community standard.
DO_NOT_TRACK=1

# ── LLM (OpenAI-compatible local server) ─────────────────────────────────────
# Ollama: http://localhost:11434/v1   vLLM: http://localhost:8000/v1
# LM Studio: http://localhost:1234/v1  llama.cpp server: http://localhost:8080/v1
# Inside docker-compose.offline.yml use the service name: http://ollama:11434/v1
JARVIS_LLM_BASE_URL=http://localhost:11434/v1
# Model id exactly as the server lists it (`ollama list`, GET /v1/models).
# Jarvis is tool-call heavy: pick a model with solid function calling.
JARVIS_LLM_MODEL=qwen2.5:7b-instruct
# openai_compatible (default, works for all of the above) | ollama (native API)
# | litellm | omniroute
# JARVIS_LLM_KIND=openai_compatible
# Only if your server requires one (vLLM --api-key, LiteLLM master key).
# JARVIS_LLM_API_KEY=
# Optional per-tier models (router mode). Unset tiers use JARVIS_LLM_MODEL.
# Screen-awareness vision calls use the `low` tier: point it at a VLM
# (e.g. qwen2.5vl:7b) or leave awareness text-only.
# JARVIS_LLM_MODEL_LOW=qwen2.5:3b-instruct
# JARVIS_LLM_MODEL_MEDIUM=qwen2.5:7b-instruct
# JARVIS_LLM_MODEL_HIGH=qwen2.5:32b-instruct
# JARVIS_LLM_MODEL_CONVERSATION=qwen2.5:7b-instruct

# ── Voice ────────────────────────────────────────────────────────────────────
# Speaches (https://github.com/speaches-ai/speaches) serves BOTH endpoints:
# /v1/audio/transcriptions (faster-whisper) and /v1/audio/speech (Kokoro).
# docker-compose.offline.yml rewires the URLs to http://speaches:8000/v1.
# Set JARVIS_TTS_PROVIDER=none / remove the STT lines for a text-only Jarvis.
JARVIS_STT_PROVIDER=local
JARVIS_STT_URL=http://localhost:8000/v1
JARVIS_STT_SERVER_TYPE=openai_compatible
# faster-whisper's own mapping for "large-v3-turbo". If setup reports it
# "NOT recognised by Speaches", use deepdml/faster-whisper-large-v3-turbo-ct2.
JARVIS_STT_MODEL=mobiuslabsgmbh/faster-whisper-large-v3-turbo
# Unset = auto-detect. Pin it (tr, en...) to stop short utterances being
# detected as the wrong language.
# JARVIS_STT_LANGUAGE=tr

JARVIS_TTS_PROVIDER=local
JARVIS_TTS_URL=http://localhost:8000/v1
JARVIS_TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
# Kokoro v1.0 has NO Turkish voice: it speaks English (a*/b* voices), Spanish,
# French, Hindi, Italian, Japanese, Portuguese, Mandarin. Turkish replies will
# be read with English pronunciation. See docs/OFFLINE.md for alternatives.
JARVIS_TTS_VOICE=af_heart

# ── GPU tuning (docker-compose.offline.yml) ──────────────────────────────────
# Ollama context window. Jarvis's first turn is ~15k tokens; do not go below 16384.
# OLLAMA_CONTEXT_LENGTH=32768
# Whisper on GPU in float16 (required on RTX 50-series). CPU fallback:
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8

# ── Daemon ───────────────────────────────────────────────────────────────────
# JARVIS_PORT=3142
# JARVIS_HOME=~/.jarvis
